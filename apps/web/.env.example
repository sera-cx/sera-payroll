# Base URL of the API. Leave empty in development: Vite proxies /v1 to http://localhost:4000.
VITE_API_BASE=
# Chain the wallet is asked to use. 11155111 is Sepolia, the public demo network. 1 is Ethereum mainnet.
VITE_CHAIN_ID=11155111
# Optional. Enables the WalletConnect connector when set.
VITE_WALLETCONNECT_PROJECT_ID=
# Development only. Serve the API from an in-browser mock built on the sample data.
VITE_MOCK_API=
