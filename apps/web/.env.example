# Web app environment. Copy to .env (dev) or set in the build step.
VITE_API_BASE=                       # empty: same origin (/v1 is proxied to the API in dev). Set to https://api.example.com when the API lives elsewhere.
VITE_CHAIN_ID=11155111               # 11155111 Sepolia, 1 Ethereum. Must match the API's CHAIN.
VITE_WALLETCONNECT_PROJECT_ID=       # optional, enables WalletConnect next to injected wallets
VITE_MOCK_API=                       # 1: run the whole product in the browser on sample data (the GitHub Pages demo)
VITE_BASE=/                          # URL path the build is served from, e.g. /sera-payroll/ on GitHub Pages
VITE_SITE_URL=                       # public origin plus base, no trailing slash, e.g. https://sera-cx.github.io/sera-payroll. Drives canonicals, sitemap and Open Graph.
