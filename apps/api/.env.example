# Sera.cx Payroll API. Copy to .env. Never commit real keys.
PORT=4000
# Postgres. Leave unset to use PGlite at .pglite/ (fine for the demo and development).
# DATABASE_URL=postgres://user:pass@localhost:5432/sera_payroll
# Demo mode: sample users can sign in without a password, "demo" approval signatures are accepted, demo balances and top-ups work.
DEMO_MODE=true
SEED_ON_START=true
WEB_ORIGIN=http://localhost:5173
# Random string, 32+ characters. Signs session cookies.
SESSION_SECRET=change-me-change-me-change-me-change-me
BRAND=[YOUR PAYROLL BRAND]
# Hold on an employee-requested address change, hours.
HOLD_HOURS=48

# Chain: mock (nothing on chain) or sepolia (the public demo).
CHAIN=mock
# RPC_URL=https://sepolia.infura.io/v3/...
# PAYROLL_DISBURSER_ADDRESS=0x...
# PAYSLIP_REGISTRY_ADDRESS=0x...
# Private key that signs payslip roots and pays gas for anchors. DEMO_MODE generates a throwaway one when unset.
# OPERATOR_SIGNER_PRIVATE_KEY=0x...

# Swap: sample (fixed sample rates, instant) or sera (Sera.cx, non-custodial, EIP-712 intents).
SWAP_PROVIDER=sample
SERA_API_BASE=https://api-testnet.sera.cx/api/v1
# Read-only key for order status. Create one by signing ManageApiKey, see docs.sera.cx.
# SERA_API_KEY=sera_...
# SERA_API_SECRET=...

# Optional providers
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# CHAINALYSIS_API_KEY=...
# Worker tick in ms (demo moves one stage per tick).
WORKER_INTERVAL_MS=1100
