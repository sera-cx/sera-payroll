{
  "name": "sera-payroll",
  "private": true,
  "version": "0.1.0",
  "description": "Source-available stablecoin payroll. Employers fund in any stablecoin or fiat, each person chooses what they receive. Settlement by Sera.cx.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @sera-payroll/db migrate",
    "db:seed": "pnpm --filter @sera-payroll/db seed",
    "demo": "pnpm --filter @sera-payroll/api demo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "uuid@<11.1.1": "^11.1.1",
      "decode-uri-component@<0.5.1": "^0.5.1",
      "esbuild@<0.25.0": "^0.25.0"
    }
  }
}
