# Sera.cx Payroll: environment variables
#
# Each app has its own .env.example with the full list and defaults:
#   apps/api/.env.example   the API, worker, adapters and chain settings
#   apps/web/.env.example   the web app (API origin, chain, WalletConnect id)
# Copy those files to .env next to them. This root file is a map of what exists.
#
# Nothing here is needed for `pnpm demo`, which runs the API in demo mode on an
# embedded PGlite database with sample data and mock adapters.

# --- Mode ---------------------------------------------------------------------
# DEMO_MODE=true           sample users, "sign in as", demo reset, mock adapters, permanent demo banner
# BRAND="[YOUR PAYROLL BRAND]"   the operator's brand. It leads; "Settlement by Sera.cx" is the only Sera.cx mark.
# WEB_ORIGIN=http://localhost:5173
# SESSION_SECRET=           long random string for session cookies

# --- Database -----------------------------------------------------------------
# DATABASE_URL=postgres://user:pass@localhost:5432/sera_payroll
#                          leave unset to use PGlite in ./.pglite (local only)

# --- Chain --------------------------------------------------------------------
# CHAIN=sepolia            sepolia | ethereum | mock. The public demo must stay on a testnet.
# RPC_URL=https://...      JSON-RPC endpoint for CHAIN
# PAYROLL_DISBURSER_ADDRESS=0x...   from `forge script` in contracts/
# PAYSLIP_REGISTRY_ADDRESS=0x...
# OPERATOR_SIGNER_PRIVATE_KEY=0x... signs payslip roots and relays anchors. Never holds funds.

# --- Sera.cx swap -------------------------------------------------------------
# SWAP_PROVIDER=sera       sera | sample (fixed sample rates, demo only)
# SERA_API_BASE=https://api-testnet.sera.cx/api/v1    mainnet: https://api.sera.cx/api/v1
# SERA_API_KEY=sera_...    read-only key, needed for /orders and /fills polling
# SERA_API_SECRET=...

# --- Screening ----------------------------------------------------------------
# CHAINALYSIS_API_KEY=     set to add the Chainalysis sanctions check to the default screening rule

# --- Ramp partners ------------------------------------------------------------
# The mock adapter is built in. Operators register their own RampAdapter per currency in code.

# --- Email --------------------------------------------------------------------
# SMTP_URL=smtp://user:pass@host:587   unset keeps the outbox log only
# SMTP_FROM="[YOUR PAYROLL BRAND] <payroll@[YOUR DOMAIN]>"
